---
config:
  look: handDrawn
  theme: base
  themeVariables:
    primaryColor: '#FFFFFF'
    secondaryColor: '#F9FAFB'
    tertiaryColor: '#F3F4F6'
    primaryTextColor: '#111827'
    primaryBorderColor: '#111827'
    lineColor: '#111827'
    fontFamily: 'Helvetica, Arial, sans-serif'
    fontSize: '11px'
    subGraphTitleTotalMargin: 6
---
flowchart TB

  subgraph PANEL_A ["Panel A: PaySim Generator Bookkeeping Leak"]
    direction LR
    subgraph CLAUSES ["Conjunction of Three Boolean Rules"]
      direction TB
      CL1["<b>1. Risky Type</b><br/><small>type ∈ {TRANSFER, CASH_OUT}</small>"]
      CL2["<b>2. Exact Account Drain</b><br/><small>amount == oldbalanceOrg</small>"]
      CL3["<b>3. Zero Remainder</b><br/><small>newbalanceOrig == 0</small>"]
    end

    TARGET["<b>Deterministic Label Recovery</b><br/><small>• Flags 8,025 of 8,213 frauds<br/>• Precision: 0.9999 · Recall: 0.9770<br/>• Zero parameters · Zero training required</small>"]

    CL1 --> TARGET
    CL2 --> TARGET
    CL3 --> TARGET
  end

  subgraph PANEL_B ["Panel B: The Feature Ablation Ladder"]
    direction TB
    RUNG1["<b>Rung 1: Full Feature Set (20 features)</b><br/><small>Includes raw balance columns + engineered error terms · Best NER = 0.0041 (Near-zero headroom)</small>"]

    RUNG2["<b>Rung 2: No Error Features (18 features)</b><br/><small>Drops errorBalanceOrig and errorBalanceDest · Best NER = 0.0094 (Shortcut reconstructed by trees)</small>"]

    RUNG3["<b>Rung 3: No Origin Balance (14 features) — SELECTED BASELINE</b><br/><small>Drops all 6 origin balance fields · Best NER = 0.1314 (Clears pre-declared headroom floor NER ≥ 0.05)</small>"]

    RUNG4["<b>Rung 4: Transaction Only (9 features) — REJECTED</b><br/><small>Drops destination balances · Best NER = 0.1931 (Rejected: destination non-crediting is not invariant)</small>"]

    RUNG1 --> RUNG2 --> RUNG3 --> RUNG4
  end

  PANEL_A -. "Necessitates ablation\nto restore headroom" .-> PANEL_B

  %% styling
  classDef default fill:#FFFFFF,stroke:#111827,stroke-width:1.5px,color:#111827
  classDef leakNode fill:#F3F4F6,stroke:#111827,stroke-width:1.5px,color:#111827
  classDef leakTarget fill:#E5E7EB,stroke:#111827,stroke-width:2px,color:#111827
  classDef selectedRung fill:#F3F4F6,stroke:#111827,stroke-width:2.5px,color:#111827
  classDef rejectedRung fill:#FFFFFF,stroke:#9CA3AF,stroke-width:1.2px,stroke-dasharray: 4 4,color:#6B7280

  class CL1,CL2,CL3 leakNode
  class TARGET leakTarget
  class RUNG1,RUNG2 default
  class RUNG3 selectedRung
  class RUNG4 rejectedRung

  style PANEL_A fill:#FFFFFF,stroke:#9CA3AF,stroke-width:1px,stroke-dasharray: 4 4
  style CLAUSES fill:#F9FAFB,stroke:#E5E7EB,stroke-width:1px
  style PANEL_B fill:#FFFFFF,stroke:#9CA3AF,stroke-width:1px,stroke-dasharray: 4 4

  linkStyle default stroke:#111827,stroke-width:1.5px