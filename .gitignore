/Literature
/Proposal

# Data (PaySim raw CSV is ~470 MB - never commit)
/data

# Generated experiment outputs. `artifacts/` is deliberately NOT here: it is
# 1.4 MB and it is what the prototype loads. `predictions/` is the 210 MB
# probability cache that notebook 06 sweeps over - regenerate it by re-running
# notebooks 03-05.
/predictions

# Third-party skills installed by `npx skills add`. The academic-researcher
# skill under .claude/skills/ is ours and IS tracked - it encodes this study's
# reporting rules, so it belongs with the study.
/.agents
/.claude
/skills-lock.json
/.claude/skills/persona-researcher

# The prototype's bundled test-set slice: derived from the gitignored raw CSV,
# rebuild with `python prototype/scripts/build_demo_sample.py`.
/prototype/data

# Environment
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# The prototype example scaffold, and the derived pickle. `artifacts/model.json`
# is the canonical bundle that `prototype/core/scorer.py` loads; `model.joblib`
# is regenerated with `python -m momo_fraud.predict --joblib`.
/prototype_example
/artifacts/model.joblib

# Editable-install build metadata (`pip install -e .`).
/src/*.egg-info/
